{
  "appId": "money.peday.commission",
  "appName": "Spark Pay",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "BackgroundRunner": {
      "label": "money.peday.commission.risk",
      "src": "runner.js",
      "event": "periodicRisk",
      "repeat": true,
      "interval": 10,
      "autoStart": true
    }
  }
}